# Copy to .env and replace the placeholder values. Never commit your real keys.
DISCORD_TOKEN=your_discord_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_provider/model_id
CHANNEL_IDS=123456789012345678

# Your Discord user ID, used for owner-only administration.
VINCENT_OWNER_ID=123456789012345678

# Limits are local to this database. Match the reset to your provider.
VINCENT_MAX_DAILY=1000
VINCENT_MAX_PER_MINUTE=18
VINCENT_BACKGROUND_CEILING=250
VINCENT_MEMORY_LIMIT=80
VINCENT_RESET_TIMEZONE=UTC
VINCENT_RESET_HOUR=0

# Optional participation is disabled until enabled deliberately.
VINCENT_UNSOLICITED_ENABLED=false
VINCENT_REACTIONS_ENABLED=true
VINCENT_MEMORY_ENABLED=true
VINCENT_AUTO_PROMOTE=false
